{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Staging execution, acceptance, budget and reference authorization v1",
  "description": "One authority for delivery-control envelopes. Product evidence completeness is validated by the protected collector and gate. Fixtures are contract tests, not native acceptance evidence.",
  "oneOf": [
    {"$ref": "#/$defs/plan"},
    {"$ref": "#/$defs/grant"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/signed_receipt"},
    {"$ref": "#/$defs/budget_approval"},
    {"$ref": "#/$defs/signed_budget_approval"},
    {"$ref": "#/$defs/reference_authorization"},
    {"$ref": "#/$defs/signed_reference_authorization"}
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "required": ["base_sha", "head_sha", "tree_sha", "executable_sha256", "config_sha256", "image_digest"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "head_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "tree_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "branch_heads": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}}
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["schema_version", "task_id", "stage", "attempt_kind", "candidate", "data_root", "quota_home", "deadline_utc", "max_runtime_seconds", "limits", "root_job", "jobs", "native_steps", "scope", "require_scheduled", "consumer"],
      "properties": {
        "schema_version": {"const": "staging_plan.v1"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"},
        "stage": {"enum": ["branch", "acceptance"]},
        "attempt_kind": {"enum": ["small", "acceptance", "rebuild"]},
        "candidate": {"$ref": "#/$defs/candidate"},
        "data_root": {"type": "string", "pattern": "^(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\)"},
        "quota_home": {"type": "string", "pattern": "^(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\)"},
        "deadline_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "max_runtime_seconds": {"type": "integer", "minimum": 1},
        "limits": {"$ref": "#/$defs/limits"},
        "root_job": {"type": "string", "minLength": 1},
        "jobs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["upstream_job", "max_runs"],
            "properties": {
              "upstream_job": {"anyOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
              "max_runs": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "native_steps": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}},
        "scope": {
          "type": "object",
          "required": ["instrument_ids", "timeframes", "start_utc", "end_utc", "max_changed_window_days"],
          "properties": {
            "instrument_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1},
            "timeframes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "minItems": 1},
            "start_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
            "end_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
            "max_changed_window_days": {"type": "integer", "minimum": 1},
            "max_source_bytes": {"type": "integer", "minimum": 1},
            "full_history": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "require_scheduled": {"type": "boolean"},
        "consumer": {"type": "object"},
        "source": {"type": "object"},
        "required_scenarios": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "verifier_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "seed_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "producer_parameters": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "object"}
        },
        "execution_window": {
          "type": "object",
          "required": ["start_utc", "end_utc"],
          "properties": {
            "start_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
            "end_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"}
          },
          "additionalProperties": false
        },
        "daily_execution_window_utc": {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "minLength": 5, "maxLength": 5, "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
            "end": {"type": "string", "minLength": 5, "maxLength": 5, "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"}
          },
          "additionalProperties": false
        },
        "mode": {"enum": ["candidate", "reference"], "default": "candidate"},
        "reference": {
          "type": "object",
          "required": ["main_sha", "receipt", "timezone"],
          "properties": {
            "main_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            "receipt": {"$ref": "#/$defs/signed_receipt"},
            "timezone": {"const": "Europe/Moscow"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {"not": {"required": ["execution_window", "daily_execution_window_utc"]}},
        {
          "if": {"required": ["mode"], "properties": {"mode": {"const": "reference"}}},
          "then": {
            "required": ["reference"],
            "properties": {"stage": {"const": "acceptance"}, "attempt_kind": {"const": "acceptance"}, "require_scheduled": {"const": true}}
          },
          "else": {"not": {"required": ["reference"]}}
        }
      ]
    },
    "grant": {
      "type": "object",
      "required": ["schema_version", "plan_sha256", "root_reservation_id", "run_id", "native_entry", "output_path", "nonce", "deadline_utc"],
      "properties": {
        "schema_version": {"const": "staging_grant.v1"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_reservation_id": {"type": "string", "pattern": "^(?:[0-9a-f]{32}|[0-9a-f]{64})$"},
        "run_id": {"type": "string", "minLength": 1},
        "native_entry": {"type": "string", "minLength": 1},
        "output_path": {"type": "string", "pattern": "^(?:/|[A-Za-z]:[/\\\\]|\\\\\\\\)"},
        "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "deadline_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "task_id": {"type": "string", "minLength": 1},
        "root_run_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["schema_version", "task_id", "stage", "candidate", "plan_sha256", "issued_at_utc", "expires_at_utc", "verifier_revision", "source", "outputs", "runs", "schedule", "changed_windows", "qc", "consumer", "coverage", "runtime"],
      "properties": {
        "schema_version": {"const": "staging_receipt.v1"},
        "task_id": {"type": "string", "minLength": 1},
        "stage": {"enum": ["branch", "acceptance"]},
        "candidate": {"$ref": "#/$defs/candidate"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "expires_at_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "verifier_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "source": {"type": "object"},
        "outputs": {"type": "object"},
        "runs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
        "schedule": {"type": "object"},
        "changed_windows": {"type": "integer", "minimum": 1},
        "qc": {"type": "object"},
        "consumer": {"type": "object"},
        "coverage": {"type": "object"},
        "runtime": {"type": "object"},
        "compute_origin": {
          "type": "object",
          "required": ["receipt_sha256", "signed_receipt"],
          "properties": {
            "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "signed_receipt": {
              "allOf": [{"$ref": "#/$defs/signed_receipt"}, {"properties": {"payload": {"not": {"required": ["compute_origin"]}}}}]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signed_receipt": {
      "type": "object",
      "required": ["schema_version", "key_id", "payload", "signature"],
      "properties": {
        "schema_version": {"const": "staging_signed_receipt.v1"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "payload": {"$ref": "#/$defs/receipt"},
        "signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": ["small", "acceptance", "rebuild"],
      "properties": {
        "small": {"type": "integer", "minimum": 0},
        "acceptance": {"type": "integer", "minimum": 0},
        "rebuild": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "budget_approval": {
      "type": "object",
      "required": ["schema_version", "task_id", "authorization_id", "reason", "previous_policy_sha256", "new_limits", "issued_at_utc"],
      "properties": {
        "schema_version": {"const": "staging_budget_approval.v1"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"},
        "authorization_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"},
        "reason": {"type": "string", "minLength": 1},
        "previous_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_limits": {"$ref": "#/$defs/limits"},
        "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"}
      },
      "additionalProperties": false
    },
    "signed_budget_approval": {
      "type": "object",
      "required": ["schema_version", "key_id", "payload", "signature"],
      "properties": {
        "schema_version": {"const": "staging_signed_budget_approval.v1"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "payload": {"$ref": "#/$defs/budget_approval"},
        "signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reference_authorization": {
      "type": "object",
      "required": ["schema_version", "task_id", "plan_sha256", "main_sha", "receipt_sha256", "authorization_id", "reason", "issued_at_utc"],
      "properties": {
        "schema_version": {"const": "staging_reference_authorization.v1"},
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"},
        "authorization_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"},
        "reason": {"type": "string", "minLength": 1},
        "issued_at_utc": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "main_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "signed_reference_authorization": {
      "type": "object",
      "required": ["schema_version", "key_id", "payload", "signature"],
      "properties": {
        "schema_version": {"const": "staging_signed_reference_authorization.v1"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
        "payload": {"$ref": "#/$defs/reference_authorization"},
        "signature": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
